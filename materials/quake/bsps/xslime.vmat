
Layer0
{
	shader "csgo_lightmappedgeneric.vfx"

	F_RENDER_BACKFACES 1

	F_TEXTURETRANSFORMS 1

	F_TRANSLUCENT 1

	g_flModelTintAmount "1.000"
	g_flVertexColorOpacityScale "1.000"
	g_vColorTint "[1.000000 1.000000 1.000000 0.000000]"

	g_bFogEnabled "1"

	g_flMetalness "0.000"

	g_flLayer1NormalTexCoordRotation "0.000"
	g_flLayer1TexCoordRotation "0.000"
	g_vLayer1NormalTexCoordCenter "[0.500 0.500]"
	g_vLayer1NormalTexCoordOffset "[0.000 0.000]"
	g_vLayer1NormalTexCoordScale "[1.000 1.000]"
	g_vLayer1TexCoordCenter "[0.500 0.500]"
	g_vLayer1TexCoordOffset "[0.000 0.000]"
	g_vLayer1TexCoordScale "[1.000 1.000]"
	g_vLayer1Tint "[1.000000 1.000000 1.000000 0.000000]"
	TextureLayer1AmbientOcclusion "materials/default/default_ao.tga"
	TextureLayer1Color "materials/quake/bsps/xslime.png"
	TextureLayer1Normal "materials/default/default_normal.tga"
	TextureLayer1Roughness "materials/default/default_rough.tga"
	TextureLayer1Translucency "[0.804000 0.804000 0.804000 0.000000]"

	g_nTextureAddressModeU "0"
	g_nTextureAddressModeV "0"

	g_flOpacityScale "0.805"

	Attributes
	{
		texturescrollvar "$baseTextureTransform"
		texturescrollrate "150"
		texturescrollangle "0"
	}

	DynamicParams
	{
		g_flLayer1TexCoordRotation "4.0 * sin( time() * 0.70 )\n"
		g_vLayer1TexCoordOffset "t = time();\nreturn float2( 0.06 * sin(t * 0.90), 0.06 * cos(t * 1.10) );\n"
		g_vLayer1TexCoordScale "t = time();\nreturn float2( 1.0 + 0.05 * sin(t * 0.60), 1.0 + 0.05 * cos(t * 0.50) );\n"
	}


	VariableState
	{
		"Color"
		{
		}
		"Fog"
		{
		}
		"Lighting"
		{
			"Metalness" 0
		}
		"PBR 1"
		{
			"Albedo" 0
			"Albedo Translucency" 0
			"Normal" 0
			"Roughness" 0
			"Ambient Occlusion" 0
		}
		"Texture Address Mode"
		{
		}
		"Translucent"
